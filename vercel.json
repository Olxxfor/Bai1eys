{
  "version": 2,
  "builds": [
    { "src": "api/[...path].js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/v1/(.*)", "dest": "/api/$1" },
    { "src": "/docs/?$", "dest": "/docs.html" },
    { "src": "/information/?$", "dest": "/information.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
